<Project Sdk="Microsoft.NET.Sdk">

  <!-- Run in Release with "dotnet run", followed by the arguments of BenchmarkDotNet (see Program.cs). Never packed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- The synthetic file builder of the tests, compiled here too (no copy). -->
    <Compile Include="..\..\tests\Eleris.RawNet.Tests\Synthetic\*.cs" Exclude="..\..\tests\Eleris.RawNet.Tests\Synthetic\SyntheticNefTests.cs" LinkBase="Synthetic" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Eleris.RawNet\Eleris.RawNet.csproj" />
  </ItemGroup>

</Project>
